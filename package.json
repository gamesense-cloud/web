{
  "name": "gamesense-cloud-forum",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "gamesense.cloud — a counter-strike 2 community forum, in the loader's house style.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch src/backend/server.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node src/backend/server.js",
    "db:migrate": "node database/migrate.js",
    "db:seed": "node database/seed.js",
    "db:reset": "node database/migrate.js --fresh && node database/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "shots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "supertest": "^7.0.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
