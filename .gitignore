# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# environment — .env.example is committed, .env is not
.env
.env.local
.env.*.local

# database — the file is generated by `npm run db:reset`
database/*.db
database/*.db-journal
database/*.db-wal
database/*.db-shm

# user uploads — the directory is kept, its contents are not
public/uploads/*
!public/uploads/.gitkeep

# logs
*.log
npm-debug.log*
logs/

# editors / os
.vscode/
.idea/
.DS_Store
Thumbs.db

# test output
coverage/

# screenshot output from `npm run shots`
shots/
