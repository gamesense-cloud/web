# Copy to .env and fill in. Every value below has a safe default in
# config/index.js except JWT_SECRET, which the server refuses to start
# without when NODE_ENV=production.

NODE_ENV=development

API_PORT=4000
WEB_ORIGIN=http://localhost:5173

JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

DATABASE_FILE=./database/dashboard.db

UPLOAD_DIR=./public/uploads
UPLOAD_MAX_BYTES=20971520

RATE_WINDOW_MS=60000
RATE_MAX_REQUESTS=240
RATE_MAX_AUTH=10
RATE_MAX_POSTS=12
